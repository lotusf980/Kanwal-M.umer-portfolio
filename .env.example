# ─────────────────────────────────────────────────────────────
# Portfolio environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env*` files. All secrets live server-side only.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG images, RSS)
# Example: https://yourname.com
NEXT_PUBLIC_SITE_URL=

# ── Contact form ─────────────────────────────────────────────
# Email delivery via Resend. Get a key at https://resend.com
# Docs: https://resend.com/docs
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # where form messages are delivered
CONTACT_FROM_EMAIL=          # the verified "From" address, e.g. onboarding@resend.dev

# ── GitHub (server-side only) ────────────────────────────────
# Public GitHub username shown on the site (safe to expose)
NEXT_PUBLIC_GITHUB_USERNAME=
# Personal access token for GitHub API calls (server-only, 5000 req/hr)
# Scopes: read-only. See https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Dashboard (optional) ────────────────────────────────────
# Single shared secret used to protect /dashboard. Any long random string.
ADMIN_TOKEN=
